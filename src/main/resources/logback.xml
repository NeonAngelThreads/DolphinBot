<configuration>
    <appender name="CONSOLE" class="org.angellock.impl.util.JLineAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss} %highlight(%4level)] [%logger{36}]: %msg%n</pattern>
        </encoder>
    </appender>
    
    <appender name="WEB" class="org.angellock.impl.api.WebLogAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss} %highlight(%4level)] [%logger{36}]: %msg%n</pattern>
        </encoder>
    </appender>

    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>botLogs\bot-%d{yyyy-MM-dd}_%i.log</fileNamePattern>
            <maxHistory>12</maxHistory>
            <maxFileSize>1MB</maxFileSize>
        </rollingPolicy>
        <encoder>
            <pattern>[%d{HH:mm:ss} %highlight(%4level)] [%logger{36}] %cyan(%marker): %msg%n</pattern>
        </encoder>
    </appender>

    <root level="info">
        <appender-ref ref="CONSOLE" />
        <appender-ref ref="WEB" />
        <appender-ref ref="FILE" />
    </root>
</configuration>