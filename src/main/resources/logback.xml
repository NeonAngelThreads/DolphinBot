<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <appender name="CONSOLE" class="org.angellock.impl.util.JLineAppender">
        <encoder>
            <pattern>[%d{HH:mm:ss} %level] [%logger{36}]: %msg%n</pattern>
        </encoder>
    </appender>
    <root level="info">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>